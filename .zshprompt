# Simple prompt for ZSH
# by Marcin Rataj (http://lidel.org)
# Updates: http://github.com/lidel/dotfiles/
# License: public domain
#
# vim: ts=4 et sw=4

setprompt () {

setopt prompt_subst
autoload -Uz vcs_info add-zsh-hook

# Git status in prompt:   MM?branchname
# staged changes    - green M
# unstaged changes  - red   M
# untracked files   - red   ?
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' stagedstr 'M'
zstyle ':vcs_info:*' unstagedstr 'M'
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' actionformats ' %F{yellow}%b%f|%F{red}%a%f'
zstyle ':vcs_info:*' formats       ' %F{green}%c%F{red}%u%F{yellow}%b%f'
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
+vi-git-untracked() {
    if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == 'true' ]]; then
        if command git ls-files --others --exclude-standard \
            --directory --no-empty-directory 2>/dev/null | read -r; then
            hook_com[unstaged]+='%F{red}?%f'
        fi
    fi
}
add-zsh-hook precmd vcs_info

# Show hostname only for remote sessions
if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]; then
    PR_HOST="%n@$HOST"
fi

# Two-line prompt:
#   line 1: [host:]path gitstatus
#   line 2: [root][exitcode]$ or #
PROMPT=$'$PR_TITLEBAR%B%F{cyan}${PR_HOST:+$PR_HOST:}%~%f%b${vcs_info_msg_0_}\n%(!.%B%F{red}root%f%b.)%(?..%F{cyan}[%F{red}%?%f%F{cyan}]%f)%F{cyan}%(!.#.$)%f '
RPROMPT=''
PS2='%_%F{cyan}>%f '

}
